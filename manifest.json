{
  "manifest_version": 3,
  "name": "ComfyUI Send",
  "version": "1.1.0",
  "description": "Right-click selected text or an image to run it through your ComfyUI workflow.",
  "permissions": ["contextMenus", "storage", "notifications", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "ComfyUI Send", "default_popup": "popup.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
